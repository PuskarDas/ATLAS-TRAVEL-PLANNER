TRAVEL_APP_NAME=AI-Group-Travel-Planner
TRAVEL_APP_VERSION=1.0.0
TRAVEL_DEBUG=true
TRAVEL_ENVIRONMENT=development
TRAVEL_SERVER_HOST=0.0.0.0
TRAVEL_SERVER_PORT=8000
TRAVEL_SECRET_KEY=your-secret-key-change-this-in-production
TRAVEL_FRONTEND_URL=http://localhost:3000

# Database (MySQL 8 on Windows: service is often "MySQL80", port 3306)
# URL shape: mysql+pymysql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
# Use mysql+pymysql (not mysql://) so Python uses PyMySQL, not MySQLdb.
# If PASSWORD has @ # : / etc., URL-encode it (e.g. @ -> %40).
# Create DB once in MySQL: CREATE DATABASE travel_planner CHARACTER SET utf8mb4;
TRAVEL_DATABASE_TYPE=mysql
TRAVEL_DATABASE_URL=mysql+pymysql://user:password@localhost:3306/travel_planner
TRAVEL_MONGODB_URL=

# JWT
TRAVEL_ACCESS_TOKEN_EXPIRE_MINUTES=30
TRAVEL_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
TRAVEL_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# ─────────────────────────────────────────
# EXTERNAL API KEYS (Required for features)
# ─────────────────────────────────────────

# Weather API (OpenWeatherMap)
# Get free key at: https://openweathermap.org/api
TRAVEL_OPENWEATHER_API_KEY=

# Google Maps API (for location services)
# Get free key at: https://console.cloud.google.com
TRAVEL_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# OpenTripMap API (local attractions)
# Get free key at: https://opentripmap.io
TRAVEL_OPENTRIPMAP_API_KEY=your_opentripmap_api_key_here

# Skyscanner API (flight prices) - Optional, we provide estimates
# Get at: https://rapidapi.com/skyscanner/api/skyscanner-flight-search
TRAVEL_SKYSCANNER_API_KEY=your_skyscanner_api_key_here

# Hotel API - Optional, we provide estimates
TRAVEL_HOTEL_API_KEY=your_hotel_api_key_here

# ─────────────────────────────────────────
# EMAIL CONFIGURATION
# ─────────────────────────────────────────

TRAVEL_SMTP_SERVER=smtp.gmail.com
TRAVEL_SMTP_PORT=587
TRAVEL_SMTP_USERNAME=your_email@gmail.com
TRAVEL_SMTP_PASSWORD=your_app_password
TRAVEL_SMTP_FROM_EMAIL=noreply@travelplanner.com

# ─────────────────────────────────────────
# REDIS & CELERY (Optional)
# ─────────────────────────────────────────

TRAVEL_REDIS_URL=redis://localhost:6379/0
TRAVEL_CELERY_BROKER_URL=redis://localhost:6379/0
TRAVEL_CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ─────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────

TRAVEL_LOG_LEVEL=INFO
TRAVEL_LOG_FILE=logs/app.log
